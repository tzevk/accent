# ── SmartOfficeDb (MS SQL Server, office LAN only) ──────────────────
MSSQL_HOST=172.16.1.40
# Leave empty to auto-resolve the SQLEXPRESS dynamic port via SQL
# Browser (UDP 1434). Set explicitly if UDP 1434 is blocked:
# MSSQL_PORT=54996
MSSQL_PORT=
MSSQL_INSTANCE=SQLEXPRESS
MSSQL_DATABASE=SmartOfficedb
MSSQL_USER=crm_reader
MSSQL_PASSWORD=change-me

# ── Accent CRM webhook ──────────────────────────────────────────────
# Full URL of POST /api/attendance/webhook as reachable from THIS machine.
WEBHOOK_URL=https://your-crm-host/api/attendance/webhook
# Must equal SMARTOFFICE_WEBHOOK_SECRET in the CRM's .env
WEBHOOK_SECRET=change-me

# ── Behaviour ───────────────────────────────────────────────────────
# Seconds between passes in loop mode (npm start). --once ignores this.
POLL_SECONDS=300
# Re-send window: punches newer than (last position - N minutes) are
# re-pushed every pass. The webhook upserts, so overlap is free.
LOOKBACK_MINUTES=120
# On first run (no state.json), how many days back to start from.
BACKFILL_DAYS=3
# Punches per webhook POST.
BATCH_SIZE=400
# Optional: file log (console always logs). *.log is gitignored.
LOG_FILE=sync.log
