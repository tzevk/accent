	"components": [
		{
			"name": "Sidebar Panel (expanded)",
			"kind": "nav",
			"refersTo": "sidebar",
			"description": "The shipped 16rem white sidebar: trigger and wordmark, Pages group, Masters subgroup, and account footer.",
			"html": "<aside class='ds-sidebar'><div class='ds-sidebar-header'><button class='ds-trigger' aria-label='Toggle Sidebar'><svg class='ds-icon' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='3' width='18' height='18' rx='2'/><path d='M9 3v18'/></svg></button><span class='ds-brand'>Accent</span></div><div class='ds-group-label'>Pages</div><nav class='ds-menu'><a class='ds-row' href='#'><svg class='ds-icon' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='3' width='7' height='9' rx='1'/><rect x='14' y='3' width='7' height='5' rx='1'/><rect x='14' y='12' width='7' height='9' rx='1'/><rect x='3' y='16' width='7' height='5' rx='1'/></svg><span>Dashboard</span></a><a class='ds-row' href='#'><svg class='ds-icon' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z'/></svg><span>Messages</span><span class='ds-badge'>3</span></a><button class='ds-row'><svg class='ds-icon' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='4' width='18' height='18' rx='2'/><path d='m9 9 2 2 4-4'/><path d='M15 16H9'/></svg><span>Tasks</span></button><button class='ds-row ds-row-active' data-open='true'><svg class='ds-icon' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='4' y='2' width='16' height='20' rx='2'/><path d='M9 2v20'/><path d='M13 6h4'/><path d='M13 10h4'/></svg><span>Masters</span><svg class='ds-icon ds-chevron' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='m18 15-6-6-6 6'/></svg></button><div class='ds-sub'><a class='ds-subrow' href='#'><svg class='ds-icon' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2'/><circle cx='9' cy='7' r='4'/></svg><span>Employees</span></a><a class='ds-subrow ds-subrow-active' href='#'><svg class='ds-icon' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='4' width='18' height='18' rx='2'/><path d='M16 2v4M8 2v4M3 10h18'/></svg><span>Attendance</span></a></div></nav><div class='ds-footer'><span class='ds-avatar'>AB</span><span class='ds-account'><strong>Alex Brown</strong><small>alex@example.com</small></span></div></aside>",
			"css": ".ds-sidebar{width:256px;display:flex;flex-direction:column;background:var(--sidebar-background,#ffffff);color:var(--sidebar-foreground,#64126d);border-right:1px solid var(--sidebar-border,#e9d5ff);padding:8px;font-family:Poppins,sans-serif;font-size:14px}.ds-sidebar-header{display:flex;align-items:center;gap:8px;padding:0 0 8px}.ds-brand{font-size:14px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ds-trigger{display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;flex:0 0 32px;border:0;border-radius:6px;background:transparent;color:var(--sidebar-foreground,#64126d);cursor:pointer}.ds-trigger:hover{background:var(--purple-50,#faf5ff)}.ds-trigger:focus-visible{outline:2px solid var(--sidebar-ring,#86288f);outline-offset:1px}.ds-group-label{display:flex;align-items:center;height:32px;padding:0 8px;border-radius:6px;font-size:12px;font-weight:500;color:var(--sidebar-foreground,#64126d);opacity:.7}.ds-menu{display:flex;flex-direction:column;gap:0;list-style:none;margin:0;padding:0}.ds-row{display:flex;align-items:center;gap:8px;width:100%;height:32px;padding:0 8px;border:0;border-radius:6px;background:transparent;color:var(--sidebar-foreground,#64126d);font-family:inherit;font-size:14px;text-align:left;text-decoration:none;cursor:pointer;transition:background .15s,color .15s}.ds-row:hover,.ds-row[data-open='true']{background:var(--sidebar-accent,#f3e8ff);color:var(--sidebar-accent-foreground,#64126d)}.ds-row:focus-visible{outline:2px solid var(--sidebar-ring,#86288f);outline-offset:1px}.ds-row-active{background:var(--sidebar-accent,#f3e8ff);color:var(--sidebar-accent-foreground,#64126d);font-weight:500}.ds-icon{width:16px;height:16px;flex:0 0 16px}.ds-chevron{margin-left:auto}.ds-badge{margin-left:auto;display:inline-flex;align-items:center;justify-content:center;min-width:20px;height:20px;padding:0 4px;border-radius:6px;font-size:12px;font-weight:500;font-variant-numeric:tabular-nums}.ds-sub{display:flex;flex-direction:column;gap:4px;margin:4px 0 4px 14px;padding:2px 0 2px 10px;border-left:1px solid var(--sidebar-border,#e9d5ff)}.ds-subrow{display:flex;align-items:center;gap:8px;height:28px;padding:0 8px;margin-left:-1px;border-radius:6px;color:var(--sidebar-foreground,#64126d);font-size:14px;text-decoration:none}.ds-subrow:hover,.ds-subrow-active{background:var(--sidebar-accent,#f3e8ff);color:var(--sidebar-accent-foreground,#64126d)}.ds-footer{display:flex;align-items:center;gap:8px;margin-top:auto;padding:8px 0 0;border-top:1px solid var(--sidebar-border,#e9d5ff)}.ds-avatar{display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;flex:0 0 32px;border-radius:9999px;background:var(--sidebar-primary,#64126d);color:var(--sidebar-primary-foreground,#ffffff);font-size:12px;font-weight:600}.ds-account{display:flex;flex-direction:column;min-width:0}.ds-account strong{font-size:12px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ds-account small{font-size:11px;color:var(--muted-foreground,#6b7280);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
		},
		{
			"name": "Sidebar Menu Button — Rest",
			"kind": "custom",
			"refersTo": "sidebar-menu-button",
			"description": "Default 32px sidebar row; hover and focus turn the lavender selection fill on.",
			"html": "<a class='ds-row-rest' href='#'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z'/></svg><span>Messages</span></a>",
			"css": ".ds-row-rest{display:flex;align-items:center;gap:8px;width:100%;height:32px;padding:8px;border-radius:6px;background:var(--sidebar-background,#ffffff);color:var(--sidebar-foreground,#64126d);font-family:Poppins,sans-serif;font-size:14px;font-weight:400;text-align:left;text-decoration:none;transition:background .15s,color .15s}.ds-row-rest svg{width:16px;height:16px;flex:0 0 16px}.ds-row-rest:hover,.ds-row-rest:active{background:var(--sidebar-accent,#f3e8ff);color:var(--sidebar-accent-foreground,#64126d)}.ds-row-rest:focus-visible{outline:2px solid var(--sidebar-ring,#86288f);outline-offset:0}"
		},
		{
			"name": "Sidebar Menu Button — Active",
			"kind": "custom",
			"refersTo": "sidebar-menu-button-active",
			"description": "Active route row: lavender fill, purple text, medium weight.",
			"html": "<a class='ds-row-active' href='#' aria-current='page'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2'/><circle cx='9' cy='7' r='4'/></svg><span>Employees</span></a>",
			"css": ".ds-row-active{display:flex;align-items:center;gap:8px;width:100%;height:32px;padding:8px;border-radius:6px;background:var(--sidebar-accent,#f3e8ff);color:var(--sidebar-accent-foreground,#64126d);font-family:Poppins,sans-serif;font-size:14px;font-weight:500;text-decoration:none}.ds-row-active svg{width:16px;height:16px;flex:0 0 16px}.ds-row-active:hover{background:var(--sidebar-accent,#f3e8ff)}.ds-row-active:focus-visible{outline:2px solid var(--sidebar-ring,#86288f);outline-offset:0}"
		},
		{
			"name": "Sidebar Icon Rail (collapsed)",
			"kind": "nav",
			"refersTo": "sidebar",
			"description": "The 3rem collapsed state: 32px icon rows and a dark right-side tooltip.",
			"html": "<div class='ds-rail'><button class='ds-rail-btn' aria-label='Dashboard'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='3' width='7' height='9' rx='1'/><rect x='14' y='3' width='7' height='5' rx='1'/><rect x='14' y='12' width='7' height='9' rx='1'/><rect x='3' y='16' width='7' height='5' rx='1'/></svg><span class='ds-tip'>Dashboard</span></button><button class='ds-rail-btn ds-rail-active' aria-label='Masters'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='4' y='2' width='16' height='20' rx='2'/><path d='M9 2v20'/><path d='M13 6h4'/></svg><span class='ds-tip'>Masters</span></button></div>",
			"css": ".ds-rail{width:48px;display:flex;flex-direction:column;align-items:center;gap:4px;padding:8px 0;background:var(--sidebar-background,#ffffff);border-right:1px solid var(--sidebar-border,#e9d5ff);font-family:Poppins,sans-serif}.ds-rail-btn{position:relative;display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;padding:8px;border:0;border-radius:6px;background:transparent;color:var(--sidebar-foreground,#64126d);cursor:pointer;transition:background .15s,color .15s}.ds-rail-btn svg{width:16px;height:16px}.ds-rail-btn:hover{background:var(--sidebar-accent,#f3e8ff);color:var(--sidebar-accent-foreground,#64126d)}.ds-rail-btn:focus-visible{outline:2px solid var(--sidebar-ring,#86288f);outline-offset:0}.ds-rail-active{background:var(--sidebar-accent,#f3e8ff);color:var(--sidebar-accent-foreground,#64126d)}.ds-tip{position:absolute;left:calc(100% + 8px);top:50%;transform:translateY(-50%);padding:6px 12px;border-radius:6px;background:var(--foreground,#171717);color:var(--background,#ffffff);font-size:12px;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .15s}.ds-rail-btn:hover .ds-tip,.ds-rail-btn:focus-visible .ds-tip{opacity:1}"
		},
		{
			"name": "Primary Button",
			"kind": "button",
			"refersTo": "primary-button",
			"description": "Solid brand-purple action button with a darker hover and purple focus ring.",
			"html": "<button class='ds-btn-primary'>Save changes</button>",
			"css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:36px;padding:0 16px;border:0;border-radius:6px;background:var(--purple-700,#64126d);color:#ffffff;font-family:Poppins,sans-serif;font-size:14px;font-weight:500;cursor:pointer;transition:background .15s}.ds-btn-primary:hover{background:var(--purple-800,#52105a)}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 2px #d8b4fe}.ds-btn-primary:disabled{background:#d8b4fe;cursor:not-allowed}"
		},
