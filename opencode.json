{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"accent-db": {
			"type": "local",
			"command": ["node", "scripts/mcp-mysql.mjs"],
			"enabled": true,
			"timeout": 60000
		},
		"accent-db-prod": {
			"type": "local",
			"command": ["node", "scripts/mcp-mysql.mjs"],
			"enabled": true,
			"timeout": 60000,
			"environment": {
				"NODE_ENV": "production"
			}
		},
		"context7": {
			"type": "remote",
			"url": "https://mcp.context7.com/mcp",
			"enabled": true
		}
	},
	"plugin": ["@dietrichgebert/ponytail"]
}
