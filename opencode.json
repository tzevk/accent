{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"timeout": {
			"startup": 60000
		},
		"servers": {
			"accent-db": {
				"type": "local",
				"command": ["node", "scripts/mcp-mysql.mjs"]
			},
			"accent-db-prod": {
				"type": "local",
				"command": ["node", "scripts/mcp-mysql.mjs"],
				"environment": {
					"NODE_ENV": "production"
				}
			},
			"context7": {
				"type": "remote",
				"url": "https://mcp.context7.com/mcp",
				"enabled": true
			}
		}
	}
}
