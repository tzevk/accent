# Accent CRM — environment template.
# Copy to `.env` (gitignored) and fill in real values. NEVER commit `.env`.
#   cp .env.example .env
# Keys are grouped by consumer; optional keys are commented out with their
# code defaults. Placeholders are `change-me` — no real secret belongs here.

# ── Runtime ─────────────────────────────────────────────────────────
# development | staging | production. Selects the DB_* credential block below.
NODE_ENV=development

# ── MySQL: development ──────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DEV_DB_NAME=accent_crm_dev
DEV_DB_USER=dev_db_user
DEV_DB_PASSWORD=change-me

# ── MySQL: staging / production ─────────────────────────────────────
# Read only when NODE_ENV=staging | production (src/utils/database.js, knexfile.js).
# STAGING_DB_NAME=accent_crm_staging
# STAGING_DB_USER=staging_db_user
# STAGING_DB_PASSWORD=change-me
# PROD_DB_NAME=accent_crm
# PROD_DB_USER=prod_db_user
# PROD_DB_PASSWORD=change-me

# ── MySQL: connection pool (optional, defaults shown) ───────────────
# Keep DB_CONNECTION_LIMIT low (5–8): prod MySQL max_user_connections is the cap.
# DB_CONNECT_TIMEOUT=10000
# DB_CONNECTION_LIMIT=5
# DB_CONNECT_RETRIES=3
# Proxy-local pool (src/utils/proxy-db.js, ADR-0011) — counts against the same
# MySQL connection budget, so keep the sum of both pools per instance in mind.
# PROXY_DB_CONNECTION_LIMIT=2

# ── MySQL: TLS (SEC-20) ─────────────────────────────────────────────
# off     — plaintext; local dev only.
# require — TLS without certificate verification (encrypted, unauthenticated).
# verify  — TLS with full certificate verification. PRODUCTION MUST USE THIS.
# Setting DB_SSL_CA_PATH always enables verification, whatever the mode.
# The MySQL server does not require TLS yet, so this client setting is the only
# gate until ops enables it server-side (roadmap G3); until then SEC-20 stays open.
# DB_SSL_MODE=verify
# PEM CA bundle used to verify the server certificate (private CA). When omitted
# in verify mode the system trust store is used.
# DB_SSL_CA_PATH=/etc/ssl/certs/mysql-ca.pem

# ── Attendance webhook (SmartOffice → CRM) ──────────────────────────
# Bearer secret checked by POST /api/attendance/webhook. The office sync
# service must send the same value as WEBHOOK_SECRET.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SMARTOFFICE_WEBHOOK_SECRET=change-me

# ── Dead secrets — do NOT set (SEC-25) ──────────────────────────────
# AUTH_SECRET and JWT_SECRET are legacy: nothing in src/, scripts/ or
# migrations/ reads them (sessions use a random token + SHA-256 hash stored in
# the `sessions` table). Remove both from your local `.env`. Their companion
# dependency `jsonwebtoken` is likewise unused and slated for uninstall.

# ── SmartOffice MSSQL reader (dev tooling only) ─────────────────────
# Not used by the app runtime: these feed the read-only `smartoffice-db` MCP
# server referenced from the global opencode.jsonc via {env:...}. The sync
# worker is a separate project with its own file — see
# scripts/smartoffice-sync/.env.example (it uses MSSQL_HOST/MSSQL_INSTANCE and
# carries the office LAN host/port values).
MSSQL_SERVER=mssql.internal.example
MSSQL_PORT=1433
MSSQL_USER=readonly_user
MSSQL_PASSWORD=change-me
MSSQL_DATABASE=SmartOfficedb
# The reader only issues SELECTs; keep encryption on wherever the server supports it.
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true
MSSQL_CONNECTION_TIMEOUT_MS=10000
